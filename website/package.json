{
  "name": "website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/create-route-entrypoints.mjs",
    "check": "npm run contentcheck && npm run format:check && npm run lint && npm run typecheck && npm run build",
    "contentcheck": "node ../scripts/validate-content.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs}\" \"../scripts/*.mjs\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs}\" \"../scripts/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/router-plugin": "1.168.35",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  }
}
